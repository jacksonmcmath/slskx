# Soulseek Network Configuration
SOULSEEK_USERNAME=your_soulseek_username
SOULSEEK_PASSWORD=your_soulseek_password
SOULSEEK_SERVER_HOST=vps.slsknet.org
SOULSEEK_SERVER_PORT=2271

# SLSKX Client Configuration
SLSKX_USERNAME=
SLSKX_PASSWORD=
SHARED_DIRECTORIES=
COMPLETE_DIRECTORY=/var/lib/slskx/downloads/complete
INCOMPLETE_DIRECTORY=/var/lib/slskx/downloads/incomplete

### SLSKX Web Configuration
SLSKX_SECRET_KEY_BASE=super_secret_key_base
SLSKX_HTTP_PORT=4080
SLSKX_HTTPS_PORT=4443
# SLSKX_HTTPS_KEY_PATH=
# SLSKX_HTTPS_CERT_PATH=
# SLSKX_WEB_SCHEME=http
# SLSKX_WEB_HOST=localhost
# SLSKX_WEB_PORT=4080
# SLSKX_WEB_PATH=/

### Database connection
DATABASE_USERNAME=slskx
DATABASE_PASSWORD=slskx
DATABASE_HOST=slskx-db
DATABASE_PORT=5432
DATABASE_NAME=slskx

# Specifying the database connection URL overrides the above variables, but it
# also allows you to override other shared or adapter-specific options via
# query parameters: https://hexdocs.pm/ecto/3.13.5/Ecto.Repo.html#module-urls
# DATABASE_URL=ecto://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}
